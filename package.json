{
  "name": "gavel",
  "version": "1.0.0",
  "private": true,
  "description": "Pay per result escrow for the agent economy on X Layer",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network xlayer_testnet",
    "judge": "tsx judge/judge.ts",
    "buyer": "tsx agents/buyer.ts",
    "seller": "tsx agents/seller.ts",
    "seller:bad": "tsx agents/seller-bad.ts",
    "mcp": "tsx mcp/server.ts",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "build": "npm run compile && npm run dashboard:build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ethers": "^6.13.4",
    "openai": "^4.76.1"
  }
}
